# RaktSetu Environment Configuration

# Server Port
PORT=5000

# ==============================================================================
# Indian SMS Gateway Configuration (Fast2SMS / MSG91)
# ==============================================================================

# Option 1: Fast2SMS (https://www.fast2sms.com) - Highly recommended for India (+91)
# Sign up at fast2sms.com, get your Dev API Key from the dashboard, and paste it here:
FAST2SMS_API_KEY=

# Option 2: MSG91 (https://msg91.com)
# MSG91 Auth Key & Sender ID
MSG91_AUTH_KEY=
MSG91_SENDER_ID=RAKTST

# Note: If no API key is provided, RaktSetu operates in resilient Simulated SMS Delivery Mode,
# logging outbound SMS dispatches to the SQLite sms_logs table and server console without errors.
